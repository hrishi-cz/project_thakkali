def _read_from_context_or_store(
    session_id: Optional[str],
    key: str,
    ctx_attr: Optional[str] = None,
) -> Any:
    """
    Read a value from ExecutionContext first (authoritative),
    falling back to _session_store (cache).

    Args:
        session_id: Session ID.
        key: Key in _session_store dict.
        ctx_attr: Attribute name on ExecutionContext (defaults to key).
    Returns:
        Value from EC if available and non-None, otherwise _session_store value.
    """
    ctx_attr = ctx_attr or key
    # Primary: ExecutionContext
    try:
        ctx = session_manager.get_session(session_id) if session_id else None
        if ctx:
            val = getattr(ctx, ctx_attr, None)
            if val is not None:
                return val
    except Exception:
        pass
    # Fallback: session store
    with _session_lock:
        return _session_store.get(session_id, {}).get(key)
```

