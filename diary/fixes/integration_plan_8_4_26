## FIX-08 — Fix /monitor/drift Efficiency

### Files to Modify

- `api/run_api.py`
- `monitoring/drift_detector.py`
- `pipeline/training_orchestrator.py`

### Problem

`/monitor/drift` creates a new `TrainingOrchestrator` and re-runs Phases 1–3 on every call. Should run drift detection directly on cached data.

### Exact Changes

**Replace the entire `/monitor/drift` handler** with the following implementation that:

1. Reads session cache instead of re-ingesting
2. Calls `DriftDetector.detect()` directly (no orchestrator)
3. Loads reference from `{MODEL_REGISTRY_DIR}/{model_id}/artifacts/reference_sample.npy` if available

```python
@app.post("/monitor/drift")
async def monitor_drift(request: Request) -> Dict[str, Any]:
    """
    Drift detection against cached session data.
    No pipeline re-run. O(local_cache_read) per call.
    """
    try:
        body = await request.json()
        _sid = body.get("session_id") if isinstance(body, dict) else None
        model_id: Optional[str] = body.get("model_id")
        if model_id:
            model_id = _sanitize_model_id(model_id)

        with _session_lock:
            _snapshot = _get_session_hashes(_sid)
        if not _snapshot:
            raise HTTPException(400, "No active ingestion session.")

        def _drift_sync() -> Dict[str, Any]:
            from monitoring.drift_detector import DriftDetector
            from pipeline.drift_adapter import DriftAdapter
            from data_ingestion.loader import DataLoader

            loader = DataLoader()
            cache_dir = Path("./data/dataset_cache")

            prod_frames = []
            for hash_id in _snapshot:
                lazy_ref = loader.load_cached(cache_dir / hash_id)
                if lazy_ref is not None:
                    try:
                        prod_frames.append(lazy_ref.head(5000))
                    except Exception:
                        pass
            if not prod_frames:
                raise RuntimeError("No cached data found for session.")
            prod_df = pd.concat(prod_frames, ignore_index=True)

            # Load reference distribution from registry if model_id provided
            ref_df = None
            stored_drift: Dict[str, Any] = {}
            if model_id:
                ref_npy = MODEL_REGISTRY_DIR / model_id / "artifacts" / "reference_sample.npy"
                if ref_npy.exists():
                    ref_arr = np.load(str(ref_npy))
                    ref_df = pd.DataFrame(ref_arr)
                meta_file = MODEL_REGISTRY_DIR / model_id / "metadata.json"
                if meta_file.exists():
                    with open(meta_file, encoding="utf-8") as fh:
                        stored_meta = json.load(fh)
                    stored_drift = (stored_meta.get("phases_summary", {})
                                    .get("DRIFT_DETECTION", {}))

            # Fallback: 70/30 split of production data as reference/production
            if ref_df is None:
                n = len(prod_df)
                split = max(1, int(n * 0.7))
                ref_df = prod_df.iloc[:split].copy()
                prod_df = prod_df.iloc[split:].copy()

            detector = DriftDetector()
            result = detector.detect(ref_df, prod_df)
            adapter = DriftAdapter()
            adapter.build_monitor_payload(result)

            return {
                "drift_detected":        result["drift_detected"],
                "metrics":               result["metrics"],
                "thresholds":            result["thresholds"],
                "status_per_metric":     result["status"],
                "n_reference":           result["n_reference"],
                "n_production":          result["n_production"],
                "n_features":            result["n_features"],
                "composite_score":       result.get("composite_score", 0.0),
                "retrain_triggered":     result.get("retrain_triggered", False),
                "model_id":              model_id,
                "stored_phase6_summary": stored_drift,
            }

        data = await asyncio.to_thread(_drift_sync)
        return {"status": "success", "data": data}

    except HTTPException:
        raise
    except Exception as exc:
        logger.error("/monitor/drift error: %s", exc, exc_info=True)
        return JSONResponse({"error": "Drift detection failed."}, status_code=500)
```

**In `monitoring/drift_detector.py`**, add `"reference_sample": reference_df` to the `detect()` return dict so Phase 7 can persist it.

**In `pipeline/training_orchestrator.py`**, in `_execute_phase_7_model_registry()`, after model weights are saved, add:

```python
