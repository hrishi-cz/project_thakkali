import functools
from typing import Callable, Any

def require_context(min_stage: str = "ingestion_complete"):
    """
    Decorator for API route handlers and phase methods.
    Raises HTTP 422 if context is missing or at wrong pipeline stage.
    """
    def decorator(fn: Callable) -> Callable:
        @functools.wraps(fn)
        async def wrapper(*args, **kwargs):
            # Extract session_id from kwargs or first positional arg body
            sid = kwargs.get("session_id") or (
                (args[0] if args else None)
            )
            if sid:
                from database.context_db import context_db
                ctx_data = context_db.load_context(sid)
                if ctx_data is None:
                    from fastapi import HTTPException
                    raise HTTPException(
                        status_code=422,
                        detail=f"No ExecutionContext for session {sid}. Run ingestion first."
                    )
                stage = ctx_data.get("pipeline_stage", "")
                _stage_order = [
                    "ingestion_complete", "schema_detection",
                    "target_detection", "global_aggregation",
                    "preprocessing_planning", "model_selection",
                    "training", "monitoring"
                ]
                if min_stage in _stage_order and stage in _stage_order:
                    if _stage_order.index(stage) < _stage_order.index(min_stage):
                        from fastapi import HTTPException
                        raise HTTPException(
                            status_code=422,
                            detail=(
                                f"Pipeline stage '{stage}' is before required '{min_stage}'. "
                                f"Complete earlier phases first."
                            )
                        )
            return await fn(*args, **kwargs)
        return wrapper
    return decorator
