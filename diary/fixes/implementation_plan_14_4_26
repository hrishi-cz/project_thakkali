### GAP-X7: EXPERIMENT ENGINE FOR PAPER GENERATION

**Problem**
The system has no structured ablation or experiment tracking mechanism. Paper generation (noted in the system as integrated into monitoring) requires reproducible comparisons: "fusion=none vs attention vs graph", "no graph loss vs with graph loss", etc. There is no `ExperimentManager` class and no ablation run infrastructure. The only history is `MetaLearningStore` (JSON with experiment records) which is not designed for structured ablation comparison.

**Root Cause in Current Code**
- `automl/meta_learning.py`: `MetaLearningStore` stores flat records `{dataset_meta, best_params, fusion_strategy, performance}` — no `ablation_name`, no `ablation_condition`, no structured comparison.
- No ablation-triggering code anywhere in training orchestrator or API.
- `pipeline/research_metrics.py`: Computes publishability index, ECE, Brier — but cannot compare across ablation conditions since there's no experiment grouping.

**Patch Plan**
Create `pipeline/experiment_engine.py` — a minimal `ExperimentManager` that:
1. Defines ablation conditions as config overrides.
2. Calls `TrainingOrchestrator` for each condition with modified config.
3. Stores results in a structured JSON file alongside MetaLearning records.
4. Produces a comparison table (ablation DataFrame) usable for paper generation.

**Code Patch**

```python
# ── FILE: pipeline/experiment_engine.py  [NEW FILE — ~110 lines] ─────────────

"""
ExperimentManager — structured ablation tracking for paper generation.

Ablation conditions override specific config fields and store structured
comparison results. Does NOT replace the main training pipeline — it wraps it.
"""
from __future__ import annotations

import json
import logging
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Any, Dict, List, Optional

logger = logging.getLogger(__name__)

EXPERIMENT_STORE = Path("data") / "experiments" / "ablation_results.json"


@dataclass
class AblationCondition:
    name: str                         # e.g. "no_fusion", "graph_fusion", "baseline"
    description: str
    config_overrides: Dict[str, Any]  # keys: fusion_strategy, alignment_weight, etc.
    # Result fields (populated after run)
    best_val_loss: float = 0.0
    best_val_acc: float = 0.0
    best_val_f1: float = 0.0
    n_trials: int = 0
    duration_s: float = 0.0
    ece: Optional[float] = None
    brier: Optional[float] = None
    status: str = "pending"           # "pending" | "completed" | "failed"
    error: Optional[str] = None


PREDEFINED_ABLATIONS = [
    AblationCondition(
        name="baseline_concat",
        description="Concatenation fusion, no auxiliary losses",
        config_overrides={"fusion_strategy": "concatenation", "alignment_weight": 0.0},
    ),
    AblationCondition(
        name="attention_fusion",
        description="Attention fusion, no auxiliary losses",
        config_overrides={"fusion_strategy": "attention", "alignment_weight": 0.0},
    ),
    AblationCondition(
        name="graph_fusion",
        description="Graph-aware multi-head fusion + diversity + sparsity losses",
        config_overrides={"fusion_strategy": "graph", "alignment_weight": 0.0},
    ),
    AblationCondition(
        name="uncertainty_fusion",
        description="Uncertainty-weighted fusion",
        config_overrides={"fusion_strategy": "uncertainty", "alignment_weight": 0.0},
    ),
    AblationCondition(
        name="full_system",
        description="UncertaintyGraph fusion + alignment loss + modality dropout",
        config_overrides={
            "fusion_strategy": "uncertainty_graph",
            "alignment_weight": 0.1,
            "modality_dropout_prob": 0.15,
        },
    ),
]


class ExperimentManager:
    """
    Run structured ablation experiments and store comparison results.

    Usage
    -----
    mgr = ExperimentManager(base_config, execution_context)
    mgr.run_ablations(conditions=PREDEFINED_ABLATIONS)
    df = mgr.to_dataframe()
    mgr.save()
    """

    def __init__(
        self,
        base_training_config: Any,         # TrainingConfig from training_orchestrator
        execution_context: Optional[Any] = None,
        store_path: Path = EXPERIMENT_STORE,
    ) -> None:
        self._base_config = base_training_config
        self._ctx = execution_context
        self._store_path = store_path
        self._results: List[AblationCondition] = []
        self._store_path.parent.mkdir(parents=True, exist_ok=True)

    def run_ablations(
        self,
        conditions: Optional[List[AblationCondition]] = None,
    ) -> List[AblationCondition]:
        """Run each ablation condition in sequence and store results."""
        from pipeline.training_orchestrator import TrainingOrchestrator, TrainingConfig
        conditions = conditions or PREDEFINED_ABLATIONS

        for cond in conditions:
            logger.info("ExperimentManager: running ablation '%s'", cond.name)
            t0 = time.perf_counter()
            try:
                # Build overridden config
                cfg_dict = asdict(self._base_config)
                cfg_dict.update(cond.config_overrides)
                run_config = TrainingConfig(**{
                    k: v for k, v in cfg_dict.items()
                    if k in TrainingConfig.__dataclass_fields__
                })
                orch = TrainingOrchestrator(run_config, execution_context=self._ctx)
                # Execute phases 3-7 only (reuse ingested data)
                orch._execute_phase_3_preprocessing()
                orch._execute_phase_4_model_selection()
                orch._execute_phase_5_training(hp_overrides=cond.config_overrides)
                phase5 = orch.phase_results.get("training", {})
                cond.best_val_loss = float(phase5.get("best_val_loss", 0.0))
                cond.best_val_acc = float(phase5.get("best_val_acc", 0.0))
                cond.best_val_f1 = float(phase5.get("best_val_f1", 0.0))
                cond.n_trials = int(phase5.get("n_trials", 0))
                cond.status = "completed"
            except Exception as exc:
                logger.warning("Ablation '%s' failed: %s", cond.name, exc)
                cond.status = "failed"
                cond.error = str(exc)
            finally:
                cond.duration_s = round(time.perf_counter() - t0, 2)
            self._results.append(cond)

        self.save()
        return self._results

    def to_dataframe(self) -> "pd.DataFrame":
        import pandas as pd
        rows = []
        for c in self._results:
            rows.append({
                "Condition": c.name,
                "Description": c.description,
                "Val Loss": round(c.best_val_loss, 4),
                "Val Acc": round(c.best_val_acc, 4),
                "Val F1": round(c.best_val_f1, 4),
                "Trials": c.n_trials,
                "Duration (s)": c.duration_s,
                "ECE": c.ece,
                "Brier": c.brier,
                "Status": c.status,
            })
        return pd.DataFrame(rows)

    def save(self) -> None:
        payload = [asdict(c) for c in self._results]
        with open(self._store_path, "w") as f:
            json.dump(payload, f, indent=2)
        logger.info("ExperimentManager: %d results saved to %s", len(payload), self._store_path)


# ── FILE: api/run_api.py — NEW ENDPOINT ──────────────────────────────────────

@app.post("/experiments/run-ablations")
async def run_ablations(request: Request) -> Dict[str, Any]:
    """Trigger structured ablation study for paper generation."""
    try:
        from pipeline.experiment_engine import ExperimentManager, PREDEFINED_ABLATIONS
        from pipeline.training_orchestrator import TrainingConfig
        body = await request.json()
        sid = body.get("session_id")
        problem_type = body.get("problem_type", "classification_binary")
        modalities = body.get("modalities", ["tabular"])
        sources = body.get("sources", [])
        conditions_filter = body.get("conditions")  # optional list of condition names

        ctx = session_manager.get_session(sid) if sid else None
        base_cfg = TrainingConfig(
            dataset_sources=sources,
            problem_type=problem_type,
            modalities=modalities,
        )
        mgr = ExperimentManager(base_cfg, execution_context=ctx)
        selected_conditions = (
            [c for c in PREDEFINED_ABLATIONS if c.name in conditions_filter]
            if conditions_filter else PREDEFINED_ABLATIONS
        )
        task_id = uuid.uuid4().hex[:8]

        async def _run():
            mgr.run_ablations(selected_conditions)

        asyncio.create_task(_run())
        return {"status": "started", "task_id": task_id, "n_conditions": len(selected_conditions)}
    except Exception as exc:
        logger.error("/experiments/run-ablations error: %s", exc, exc_info=True)
        return JSONResponse({"error": str(exc)}, status_code=500)


@app.get("/experiments/ablation-results")
async def get_ablation_results() -> Dict[str, Any]:
    """Return latest ablation comparison table."""
    from pipeline.experiment_engine import EXPERIMENT_STORE
    if not EXPERIMENT_STORE.exists():
        return {"results": [], "message": "No ablation results yet. Run /experiments/run-ablations first."}
    with open(EXPERIMENT_STORE) as f:
        data = json.load(f)
    return {"results": data, "count": len(data)}
