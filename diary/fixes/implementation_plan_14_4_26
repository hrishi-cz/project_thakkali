# ── FILE: pipeline/calibration.py  [NEW FILE — ~60 lines] ───────────────────

"""Temperature scaling calibration for multimodal classifier outputs."""
from __future__ import annotations
import logging
from typing import Optional
import numpy as np

logger = logging.getLogger(__name__)


class TemperatureScaler:
    """
    Post-hoc calibration via a single learned temperature parameter.

    Platt scaling generalisation: logits_cal = logits / T
    T is optimised on a held-out validation set by minimising NLL.

    Usage
    -----
    scaler = TemperatureScaler()
    scaler.fit(val_logits, val_targets, problem_type)
    calibrated_probs = scaler.calibrate(logits)
    """

    def __init__(self) -> None:
        self.temperature: float = 1.0
        self._fitted: bool = False

    def fit(
        self,
        val_logits: "np.ndarray",
        val_targets: "np.ndarray",
        problem_type: str = "classification_binary",
        n_steps: int = 100,
        lr: float = 0.01,
    ) -> None:
        """Optimise T via scalar gradient descent on validation NLL."""
        import torch
        import torch.nn.functional as F

        logits_t = torch.tensor(val_logits, dtype=torch.float32)
        targets_t = torch.tensor(val_targets, dtype=torch.long
                                  if "multiclass" in problem_type else torch.float32)
        T = torch.nn.Parameter(torch.ones(1))
        opt = torch.optim.LBFGS([T], lr=lr, max_iter=50)

        def _closure():
            opt.zero_grad()
            scaled = logits_t / T.clamp(min=0.05)
            if "binary" in problem_type:
                loss = F.binary_cross_entropy_with_logits(
                    scaled.squeeze(-1), targets_t.float()
                )
            else:
                loss = F.cross_entropy(scaled, targets_t)
            loss.backward()
            return loss

        for _ in range(n_steps // 50):
            opt.step(_closure)

        self.temperature = float(T.clamp(min=0.05).item())
        self._fitted = True
        logger.info("TemperatureScaler fitted: T=%.4f", self.temperature)

    def calibrate(self, logits: "np.ndarray") -> "np.ndarray":
        """Scale logits by 1/T and apply sigmoid/softmax."""
        import torch
        t = torch.tensor(logits, dtype=torch.float32) / max(self.temperature, 0.05)
        if t.shape[-1] == 1 or t.ndim == 1:
            probs = torch.sigmoid(t).numpy()
        else:
            probs = torch.softmax(t, dim=-1).numpy()
        return probs

    def compute_ece(
        self,
        probs: "np.ndarray",
        targets: "np.ndarray",
        n_bins: int = 15,
    ) -> float:
        """Expected Calibration Error."""
        confidences = probs.max(axis=-1) if probs.ndim > 1 else probs.ravel()
        preds = probs.argmax(axis=-1) if probs.ndim > 1 else (probs > 0.5).astype(int)
        correct = (preds == targets.ravel()).astype(float)
        bins = np.linspace(0, 1, n_bins + 1)
        ece = 0.0
        for lo, hi in zip(bins[:-1], bins[1:]):
            mask = (confidences >= lo) & (confidences < hi)
            if mask.sum() > 0:
                acc = correct[mask].mean()
                conf = confidences[mask].mean()
                ece += mask.sum() / len(confidences) * abs(acc - conf)
        return float(ece)

    def compute_brier(self, probs: "np.ndarray", targets: "np.ndarray") -> float:
        """Brier score (lower is better)."""
        p = probs.ravel()
        t = targets.ravel().astype(float)
        return float(np.mean((p - t) ** 2))


