    def set(self, key: str, tensor: torch.Tensor, meta: Optional[Dict[str, Any]] = None) -> None:
        path = self._path_for_key(key)
        payload = {
            "created_at": datetime.utcnow().isoformat(),
            "meta": dict(meta or {}),
            "tensor": tensor.detach().cpu(),
        }
        with self._lock:
            torch.save(payload, path)
            self._writes += 1

    # AFTER:
    def set(self, key: str, tensor: torch.Tensor, meta: Optional[Dict[str, Any]] = None) -> None:
        if not self._should_cache(key):
            with self._lock:
                self._skipped_writes += 1
            return  # skip writing weak-modality embeddings to disk
        path = self._path_for_key(key)
        payload = {
            "created_at": datetime.utcnow().isoformat(),
            "meta": dict(meta or {}),
            "tensor": tensor.detach().cpu(),
        }
        with self._lock:
            torch.save(payload, path)
            self._writes += 1

    # ADD: eviction utility for weak modalities
    def evict_weak_modality(self, modality: str) -> int:
        """Delete all cached .pt files whose key contains the modality name."""
        removed = 0
        with self._lock:
            for pt_file in list(self.cache_dir.glob("*.pt")):
                try:
                    payload = torch.load(pt_file, map_location="cpu")
                    meta = payload.get("meta", {}) if isinstance(payload, dict) else {}
                    if modality.lower() in str(meta.get("modality", "")).lower():
                        pt_file.unlink()
                        removed += 1
                except Exception:
                    pass
        logger.info("EmbeddingCache: evicted %d files for modality '%s'", removed, modality)
        return removed

    # EXTEND stats():
    def stats(self) -> Dict[str, int]:
        with self._lock:
            return {
                "hits": self._hits,
                "misses": self._misses,
                "writes": self._writes,
                "skipped_writes": self._skipped_writes,  # NEW
                "priorities": dict(self._modality_priorities),
            }


