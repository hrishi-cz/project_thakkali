class MemoryGuard:
    """Monitor GPU/CPU memory during training and trigger fallback if threshold exceeded."""

    def __init__(self, vram_threshold_pct: float = 0.92, ram_threshold_pct: float = 0.90):
        self.vram_threshold = vram_threshold_pct
        self.ram_threshold = ram_threshold_pct

    def check_vram(self) -> Dict[str, float]:
        if not torch.cuda.is_available():
            return {"available": False}
        total = torch.cuda.get_device_properties(0).total_memory
        reserved = torch.cuda.memory_reserved(0)
        used_pct = reserved / total
        return {"used_pct": used_pct, "critical": used_pct > self.vram_threshold}

    def check_ram(self) -> Dict[str, float]:
        import psutil
        vm = psutil.virtual_memory()
        return {"used_pct": vm.percent / 100, "critical": vm.percent / 100 > self.ram_threshold}

    def maybe_clear_cache(self) -> bool:
        """Returns True if cache was cleared."""
        status = self.check_vram()
        if status.get("critical"):
            torch.cuda.empty_cache()
            logger.warning("MemoryGuard: VRAM %.1f%% — cache cleared", status["used_pct"]*100)
            return True
        return False
