**Purpose:** Drop-in replacement for `CosineAnnealingLR` that reads `LossWeightScheduler` analysis.

```python
class AdaptiveLRScheduler(torch.optim.lr_scheduler._LRScheduler):
    """
    Cosine annealing base with adaptive multiplier from TrialIntelligence.

    Every epoch, checks LossWeightScheduler.last_analysis:
      overfitting  → multiply LR by 0.70
      underfitting → multiply LR by 1.05
      good         → maintain cosine trajectory
    """

    def __init__(
        self,
        optimizer: torch.optim.Optimizer,
        T_max: int,
        loss_weight_scheduler: Optional["LossWeightScheduler"] = None,
        eta_min: float = 0.0,
        last_epoch: int = -1,
    ):
        self.T_max = T_max
        self.eta_min = eta_min
        self._lws = loss_weight_scheduler
        self._base_cosine = torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer, T_max=T_max, eta_min=eta_min
        )
        super().__init__(optimizer, last_epoch)

    def get_lr(self):
        cosine_lrs = self._base_cosine.get_last_lr() or self.base_lrs
        analysis = getattr(self._lws, "last_analysis", {}) if self._lws else {}
        fit_type = str(analysis.get("fit_type", "good"))
        multiplier = {"overfitting": 0.70, "underfitting": 1.05}.get(fit_type, 1.0)
        return [max(self.eta_min, lr * multiplier) for lr in cosine_lrs]

    def step(self, *args, **kwargs):
        self._base_cosine.step()
        super().step(*args, **kwargs)
