**Purpose:** Per-call latency enforcement with configurable timeout.

```python
class LatencyGuard:
    """Context manager that enforces a maximum wall-clock time budget."""

    def __init__(self, budget_s: float, fallback_fn: Optional[Callable] = None):
        self.budget_s = float(budget_s)
        self._fallback_fn = fallback_fn

    def __enter__(self): self._start = time.perf_counter(); return self
    def __exit__(self, *_): pass

    def check(self):
        elapsed = time.perf_counter() - self._start
        if elapsed > self.budget_s:
            if self._fallback_fn:
                return self._fallback_fn()
            raise TimeoutError(f"LatencyGuard: exceeded {self.budget_s:.1f}s budget")

    @staticmethod
    def timed(func, budget_s: float, *args, **kwargs):
        """Run func in a thread with a strict timeout."""
        import concurrent.futures
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as ex:
            fut = ex.submit(func, *args, **kwargs)
            try:
                return fut.result(timeout=budget_s)
            except concurrent.futures.TimeoutError:
                raise TimeoutError(f"Function exceeded {budget_s}s budget")
```

