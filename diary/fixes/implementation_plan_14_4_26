class AdaptivePreprocessingEngine:
    """
    Reads ExecutionContext intelligence to configure preprocessing.
    Replaces PreprocessingPlanner as the authoritative planning module.
    """

    def __init__(self, ctx: ExecutionContext):
        self._ctx = ctx

    def build_tabular_config(self, X: pd.DataFrame) -> Dict[str, Any]:
        pred_scores = self._ctx.predictability_scores or {}
        tab_pred = float(next(iter(pred_scores.values()), 0.5))
        schema = self._ctx.global_schema or {}
        
        col_stats = self._compute_column_stats(X)

        return {
            "add_polynomial": tab_pred < 0.30,
            "poly_degree": 2,
            "interaction_only": True,
            "drop_correlation_threshold": 0.95 if tab_pred > 0.70 else None,
            "imputer_strategy": "knn" if col_stats["missing_rate"] > 0.10 else "median",
            "scaler": "robust" if col_stats["outlier_rate"] > 0.05 else "standard",
            "weak_feature_threshold": 1.0 - tab_pred,
        }

    def get_weak_modalities(self) -> List[str]:
        pred_scores = self._ctx.predictability_scores or {}
        return [m for m, s in pred_scores.items() if s < 0.25]

    def get_fusion_recommendation(self) -> str:
        """Use predictability imbalance to select fusion strategy."""
        scores = list((self._ctx.predictability_scores or {}).values())
        if len(scores) < 2:
            return "concatenation"
        variance = float(np.var(scores))
        if variance > 0.10:
            return "uncertainty"  # modalities differ greatly → uncertainty weighting
        if len(scores) >= 3:
            return "uncertainty_graph"
        return "attention"

    @staticmethod
    def _compute_column_stats(X: pd.DataFrame) -> Dict[str, float]:
        missing_rate = float(X.isnull().mean().mean())
        numeric_cols = X.select_dtypes(include=[np.number])
        if numeric_cols.empty:
            outlier_rate = 0.0
        else:
            q1, q3 = numeric_cols.quantile(0.25), numeric_cols.quantile(0.75)
            iqr = q3 - q1
            outlier_rate = float(((numeric_cols < q1 - 1.5*iqr) | (numeric_cols > q3 + 1.5*iqr)).mean().mean())
        return {"missing_rate": missing_rate, "outlier_rate": outlier_rate}
