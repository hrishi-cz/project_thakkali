### PATCH-01: `database/context_db.py`
**Change:** Add probe sample persistence methods.

```python
# BEFORE: no probe sample storage

# AFTER: add to ContextDatabase class:
def save_probe_sample(self, session_id: str, X: np.ndarray, y: np.ndarray) -> None:
    """Persist probe sample as compressed bytes to avoid in-memory volatility."""
    import io, gzip
    buf = io.BytesIO()
    np.savez_compressed(buf, X=X, y=y)
    compressed = gzip.compress(buf.getvalue())
    with self._get_conn() as conn:
        conn.execute(
            "INSERT OR REPLACE INTO probe_samples (session_id, data, updated_at) VALUES (?,?,?)",
            (session_id, compressed, datetime.utcnow().isoformat())
        )

def load_probe_sample(self, session_id: str) -> Optional[Tuple[np.ndarray, np.ndarray]]:
    import io, gzip
    with self._get_conn() as conn:
        row = conn.execute(
            "SELECT data FROM probe_samples WHERE session_id=?", (session_id,)
        ).fetchone()
    if row is None:
        return None
    buf = io.BytesIO(gzip.decompress(row[0]))
    data = np.load(buf)
    return data["X"], data["y"]
```

**Also add** `CREATE TABLE IF NOT EXISTS probe_samples` to `_init_schema()`.

